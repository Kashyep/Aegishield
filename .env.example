# ==============================================================================
# AegisShield Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Gateway Configuration
# ------------------------------------------------------------------------------
# Set AEGIS_LLM_MODE to 'off' (default for demo/offline), 'recorded', or 'live'.
# - off: Fallback to deterministic prompt templates (no network calls)
# - recorded: Replay recorded JSON responses by request hash from fixtures/llm/recorded
# - live: Call OpenAI-compatible chat completion provider
# Note: 'live' mode requires AEGIS_LLM_API_KEY and a working model slug
# (meta-llama/llama-3.3-70b-instruct:free returned 404 on 2026-10-23).
AEGIS_LLM_MODE=off

# OpenAI-compatible API endpoint (e.g. OpenAI, Groq, OpenRouter, Together)
AEGIS_LLM_BASE_URL=https://api.openai.com/v1

# Model identifier
AEGIS_LLM_MODEL=gpt-4o-mini

# API key for the LLM provider (placeholder only)
AEGIS_LLM_API_KEY=your-api-key-here

# Timeout in seconds for live LLM requests (default: 8.0)
AEGIS_LLM_TIMEOUT_S=8.0

# ------------------------------------------------------------------------------
# Backend & Storage Configuration
# ------------------------------------------------------------------------------
# Path to SQLite database file (default: work/aegis-demo.sqlite3 relative to repo root)
# AEGIS_DB_PATH=work/aegis-demo.sqlite3

# Demo mode toggle (1, true, yes to enable; default: 1)
# Enables mock fixture loading and POST /api/v1/demo/reset
# AEGIS_DEMO_MODE=1

# Comma-separated browser origins allowed to access the API via CORS
# (default: http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4174)
# AEGIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4174

# Path to built frontend static assets served at / by backend (default: frontend/dist)
# AEGIS_FRONTEND_DIST=frontend/dist

# ------------------------------------------------------------------------------
# Operational & Testing Controls (Unset by default)
# ------------------------------------------------------------------------------
# Failure injection drill: simulate failure at specific recovery execution step (1-6).
# Leave unset for normal execution.
# AEGIS_SIMULATE_FAIL_AT_STEP=

# Demo reset protection token. Unset by default.
# When set, POST /api/v1/demo/reset requires request header 'X-Reset-Token' matching this value.
# AEGIS_RESET_TOKEN=your-reset-token-here

# ------------------------------------------------------------------------------
# Frontend Build-time Variables (Vite)
# ------------------------------------------------------------------------------
# Note: Frontend environment variables are evaluated by Vite at build time (or dev start).
# They do not take effect dynamically at runtime in the browser without rebuild.
#
# VITE_API_MODE:
#   - 'stub' (default): Frontend uses local mock fixtures directly in browser
#   - 'live': Frontend connects to backend REST API
#
# VITE_API_BASE_URL:
#   - Backend base URL for live API mode (default: http://localhost:8000)
#   - In unified container deployments, set to '/' for same-origin routing
#
# Example Vite env configuration (e.g. in frontend/.env):
# VITE_API_MODE=live
# VITE_API_BASE_URL=http://localhost:8000
