        "non_party_conditions": ["transit_justified_geographic_or_transport", "not_entered_trade_or_consumption", "no_operation_beyond_unloading_reloading_preservation"],
        "evidence_required": ["through_bill_of_lading", "transit_customs_documentation"]
      },
      "extraction": {"method": "manual_gold", "verified": true}
    },
